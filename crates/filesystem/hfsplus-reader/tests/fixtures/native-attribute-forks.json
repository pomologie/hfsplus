{
  "profile": "Clean HFS+ with native contiguous and fragmented fork-backed attributes",
  "oracle": {
    "os": "14.7.2",
    "build": "23H311",
    "arch": "arm64",
    "readback": "Darwin getxattr on the disposable mounted volume returned exact byte lengths and contents before detach. Independent raw extent assembly then matched the same payloads."
  },
